@baseUrl = http://localhost:3000

### RESERVATIONS
GET {{baseUrl}}/reservations
### By id
GET {{baseUrl}}/reservations/1
### create
POST {{baseUrl}}/reservations
Content-Type: application/json

{
    "client_id": 1,
    "staff_id": 1
}
### update
PATCH {{baseUrl}}/reservations/1
Content-Type: application/json

{
    "reservation_status": "completed"
}


